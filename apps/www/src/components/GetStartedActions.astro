---
import { listedMobileApps, MOBILE_PLATFORMS } from "@robots/contracts/mobile-app";
import type { HomeCopy } from "../i18n/home";
import { DESKTOP_PLATFORMS, desktopDownloadHref } from "../github";
import { APP_URL, GITHUB_URL } from "../site";

type Props = {
  class: string;
  copy: HomeCopy["hero"];
  desktop?: boolean;
  placement: string;
  githubLabel?: string;
};

const { class: className, copy, desktop, placement, githubLabel = copy.viewOnGithub } =
  Astro.props;

const listedMobile = listedMobileApps();
const mobileStores = listedMobile.map(({ platform, href }) => ({
  platform,
  label: copy.download[platform],
  href,
}));
const webAppPlatforms = [
  "mac",
  "windows",
  "linux",
  "web",
  ...MOBILE_PLATFORMS.filter((platform) => !listedMobile.some((app) => app.platform === platform)),
].join(" ");
const desktopDownloads = (desktop ? DESKTOP_PLATFORMS : []).map((platform) => ({
  platform,
  label: copy.download[platform],
  href: desktopDownloadHref(platform),
}));
const githubPlatforms = ["ios", "android", "web", "mac", "windows", "linux"]
  .filter((platform) => !desktopDownloads.some((download) => download.platform === platform))
  .join(" ");
---

<div class={className}>
  <a class="button button--primary" href={APP_URL} data-show={webAppPlatforms}>
    {copy.getStarted}
  </a>
  {
    mobileStores.map((store) => (
      <a class="button button--primary" href={store.href} data-show={store.platform}>
        {store.label}
      </a>
    ))
  }
  {
    desktopDownloads.map((download) => (
      <a class="button button--secondary" href={download.href} data-show={download.platform}>
        {download.label}
      </a>
    ))
  }
  <a
    class="button button--secondary"
    href={GITHUB_URL}
    target="_blank"
    rel="noopener"
    data-show={githubPlatforms}
    data-attr={`${placement}-github`}
  >
    {githubLabel}
  </a>
</div>
