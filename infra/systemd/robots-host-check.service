[Unit]
Description=Check host storage, backup health and SSH access rules

[Service]
Type=oneshot
EnvironmentFile=-/etc/robots/backup.env
ExecStart=/usr/local/sbin/robots-host-check
StateDirectory=robots/alerts
StateDirectoryMode=0700
ProtectSystem=strict
ReadWritePaths=/var/lib/robots/alerts
ProtectHome=true
PrivateTmp=true
